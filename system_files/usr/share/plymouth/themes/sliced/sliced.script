// Question prompt
question = null;
answer = null;

// Message
message = null;

// Password prompt
bullets = null;
prompt = null;
bullet.image = Image.Text("*", 1, 1, 1);

// Flow
state.status = "play";
state.time = 0.0;

// initalize arrays
spr = [];
question_spr = [];
answer_spr = [];
prompt_spr = [];
message_spr = [];
bullet_spr = [];
flyingman_image = [];

//--------------------------------- Refresh (Logo animation) --------------------------

# --- gather frames once
for (i = 0; i < 45; i++)
  flyingman_image[i] = Image("progress-" + i + ".png");

# --- build one sprite per display and center it on that display
num_displays = Window.GetNumDisplays();
for (d = 0; d < num_displays; d++) {
  spr[d] = Sprite();
  # center on display d
  cx = Window.GetX(d) + (Window.GetWidth(d)  - flyingman_image[0].GetWidth())  / 2;
  cy = Window.GetY(d) + (Window.GetHeight(d) - flyingman_image[0].GetHeight()) / 2;
  spr[d].SetX(cx);
  spr[d].SetY(cy);
}

progress = 0;
fun refresh_callback () {
  img = flyingman_image[Math.Int(progress / 2) % 45];
  # update all displays
  for (d = 0; d < num_displays; d++)
    spr[d].SetImage(img);
  progress++;
}

Plymouth.SetRefreshFunction (refresh_callback);

# -------------------------------- Helpers --------------------------------
fun center_sprite_on_display(img, d, y_from_bottom_mult) {
  s = Sprite(img);
  s.SetX(Window.GetX(d) + (Window.GetWidth(d) - img.GetWidth()) / 2);
  s.SetY(Window.GetY(d) + Window.GetHeight(d) - y_from_bottom_mult * img.GetHeight());
  return s;
}

fun center_x_for_width_on_display(w, d) {
  return Window.GetX(d) + (Window.GetWidth(d) - w) / 2;
}

# -------------------------------- Question --------------------------------
fun DisplayQuestionCallback(prompt, entry) {
  question_spr = [];
  answer_spr   = [];
  if (entry == "") entry = "<answer>";

  question.image = Image.Text(prompt, 1, 1, 1);
  answer.image   = Image.Text(entry,  1, 1, 1);

  for (d = 0; d < num_displays; d++) {
    question_spr[d] = center_sprite_on_display(question.image, d, 4);  # 4*line height from bottom
    answer_spr[d]   = center_sprite_on_display(answer.image,   d, 2);  # 2*line height from bottom
  }
}

Plymouth.SetDisplayQuestionFunction(DisplayQuestionCallback);

# -------------------------------- Password --------------------------------
fun DisplayPasswordCallback(nil, bulletCount) {
  state.status = "pause";

  prompt.image = Image.Text("Enter Password", 1, 1, 1);

  # clear old prompt/bullets
  prompt_spr = [];
  bullet_spr = [];

  for (d = 0; d < num_displays; d++) {
    prompt_spr[d] = center_sprite_on_display(prompt.image, d, 4);

    totalWidth = bulletCount * bullet.image.GetWidth();
    startX = center_x_for_width_on_display(totalWidth, d);
    baseY  = Window.GetY(d) + Window.GetHeight(d) - 2 * bullet.image.GetHeight();

    bullet_spr[d] = [];
    for (i = 0; i < bulletCount; i++) {
      bullet_spr[d][i] = Sprite(bullet.image);
      bullet_spr[d][i].SetX(startX + i * bullet.image.GetWidth());
      bullet_spr[d][i].SetY(baseY);
    }
  }
}

Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);

# ------------------------------- Normal/clear ------------------------------
fun DisplayNormalCallback() {
  state.status = "play";
  bullets = null;
  prompt = null;
  message = null;
  question = null;
  answer = null;
  question_spr = [];
  answer_spr   = [];
  prompt_spr   = [];
  bullet_spr   = [];
  message_spr  = [];
}

Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);

# -------------------------------- Message ---------------------------------
fun MessageCallback(text) {
  message.image = Image.Text(text, 1, 1, 1);

  # clear old
  message_spr = [];

  for (d = 0; d < num_displays; d++) {
    s = Sprite(message.image);
    s.SetPosition(
      Window.GetX(d) + (Window.GetWidth(d) - message.image.GetWidth()) / 2,
      Window.GetY(d) + message.image.GetHeight()  # near top
    );
    message_spr[d] = s;
  }
}

Plymouth.SetMessageFunction(MessageCallback);