FROM scratch AS ctx
COPY build_files /

FROM ghcr.io/ublue-os/bazzite-deck-gnome:stable@sha256:905188d7e8e29dc02d4f8e92b259823a65ad01d2f99e3ba1dd75de655c2b412d
COPY system_files /

ARG CONTENT_HASH
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    CONTENT_HASH=$CONTENT_HASH \
    /ctx/pre-build.sh && \
    /ctx/core-packages.sh && \
    /ctx/docker.sh && \
    /ctx/gnome-shell.sh && \
    /ctx/gnome-extensions.sh && \
    /ctx/cli-tools.sh && \
    /ctx/boot.sh

RUN ostree container commit
RUN bootc container lint
