# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY build_files /

# Base Image
FROM ghcr.io/ublue-os/bazzite-gnome:stable
COPY system_files /

# Create output directory for build artifacts
RUN mkdir -p /ctx/output

# Run main build and theming scripts
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh && \
    /ctx/theme.sh

# Run build-nfi.sh to build nautilus-folder-icons and output files into /ctx/output
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,source=/ctx/output,target=/ctx/output \
    --mount=type=cache,dst=/var/cache \
    /ctx/build-nfi.sh

# Copy built nautilus-folder-icons files from output into final image
COPY --from=ctx /ctx/output/usr/share/nautilus-python/extensions/folder-icons.py /usr/share/nautilus-python/extensions/
COPY --from=ctx /ctx/output/usr/share/com.github.bilelmoussaoui.nautilus-folder-icons /usr/share/com.github.bilelmoussaoui.nautilus-folder-icons
COPY --from=ctx /ctx/output/usr/share/metainfo/com.github.bilelmoussaoui.nautilus-folder-icons.metainfo.xml /usr/share/metainfo/
COPY --from=ctx /ctx/output/usr/share/locale /usr/share/locale

# Commit OSTree and lint
RUN ostree container commit
RUN bootc container lint
